# Stochastic branching rules fitted to real trees (growpy.structure.branching_model).
#
# Apex(o, k, prev, L, phi, theta, elev, phase) is the growing end of an axis of order o
# (0 trunk, 1 limb, 2 twig) that has reached decile k (0..9) of its length L. prev is the
# event of the decile below (0 none, 1 short, 2 long, 3 fork), phi the axis azimuth, theta
# its current elevation, elev its 20 target segment elevations (a real stem's or branch's
# profile, drawn from the model), phase the running azimuth of the laterals around a trunk.
#
# Per derivation step every apex grows one decile:
#   1. draw the decile's event from the fitted Markov chain, given order, decile, prev
#   2. draw the laterals that came with such an event in a real decile (how many, what kinds)
#   3. grow two internodes, each pitched to the next target elevation
#   4. hang each lateral on one of them: a real lateral of that kind and zone gives its
#      length (over the parent's), divergence and elevation profile; it starts as a new apex
# A model object, the target height and a few constants are passed in as extern values.

extern(model=None, HEIGHT=20.0, DERIVATION=32, SUBSTEPS=2, ZONES=5, MIN_LEN=0.3)
extern(head_up=None, rng=None)

import math

module Apex(o, k, prev, L, phi, theta, elev, phase)

Axiom: Seed

derivation length: DERIVATION

production:

Seed:
  elev = model.trunk()
  e0 = float(elev[0])
  phi = float(rng.uniform(0.0, 360.0))
  rise = max(0.5, float(sum(math.sin(math.radians(x)) for x in elev)) / len(elev))
  length = HEIGHT / rise
  hx, hy, hz, ux, uy, uz = head_up(e0, phi)
  phase = float(rng.uniform(0.0, 360.0))
  produce @R(hx, hy, hz, ux, uy, uz) Apex(0, 0, 0, length, phi, e0, elev, phase)

Apex(o, k, prev, L, phi, theta, elev, phase):
  if k >= 10:
    produce
  e = model.step(o, k, prev)
  comp = model.composition(o, k, e)
  ds = L / (10.0 * SUBSTEPS)
  slots = [[] for _ in range(SUBSTEPS)]
  for c in comp:
    slots[int(rng.integers(SUBSTEPS))].append(c)
  for j in range(SUBSTEPS):
    t = float(elev[k * SUBSTEPS + j])
    dt = t - theta
    nproduce ^(dt) F(ds)
    theta = t
    where = (k + (j + 1.0) / SUBSTEPS) / 10.0
    zone = min(ZONES - 1, int(where * ZONES))
    for c in slots[j]:
      rec = model.lateral(o + 1, zone, c)
      if rec is None:
        continue
      lc = float(rec["len_rel"]) * L
      if lc < MIN_LEN:
        continue
      d = float(rec["dphi"])
      if not math.isfinite(d):
        d = 137.5 if o == 0 else float(rng.choice([-60.0, 60.0]))
      if o == 0:
        phase = (phase + d) % 360.0
        pc = phase
      else:
        pc = (phi + d) % 360.0
      ce = rec["elev"]
      c0 = float(ce[0])
      hx, hy, hz, ux, uy, uz = head_up(c0, pc)
      nproduce [ @R(hx, hy, hz, ux, uy, uz) Apex(o + 1, 0, 0, lc, pc, c0, ce, 0.0) ]
  produce Apex(o, k + 1, e, L, phi, theta, elev, phase)

endlsystem
